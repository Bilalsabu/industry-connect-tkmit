{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about page/ic web/index.html"
    },
    {
      "source": "/about-us",
      "destination": "/about page/ic web/index.html"
    },
    {
      "source": "/committee",
      "destination": "/about page/ic web/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}